{
  "name": "clipforge",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "npm run verify && next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.test.mjs",
    "verify": "npm run lint && npm run typecheck && npm test",
    "phase1:e2e": "node scripts/phase1-e2e.mjs",
    "worker:transcription": "node scripts/transcription-worker.mjs",
    "worker:transcription:once": "node scripts/transcription-worker.mjs --once",
    "worker:analysis": "node scripts/analysis-worker.mjs",
    "worker:analysis:once": "node scripts/analysis-worker.mjs --once",
    "worker:render": "node scripts/render-worker.mjs",
    "worker:render:once": "node scripts/render-worker.mjs --once",
    "render:e2e": "node scripts/render-e2e.mjs"
  },
  "dependencies": {
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}
