# ClipForge Multi — local / worker configuration

# Optional. Leave blank to use "ffmpeg" from PATH.
FFMPEG_PATH=

# Optional. Leave blank to use "ffprobe" from PATH.
FFPROBE_PATH=

# Optional. Leave blank to use "yt-dlp" from PATH.
# Render's native free build bundles this binary for supported normal page URLs.
YTDLP_PATH=

# Optional. Leave blank to use ./storage.
# IMPORTANT: jobs/projects are filesystem-persistent only when this directory
# itself lives on a persistent volume. /tmp is ephemeral across instance replacement.
CLIPFORGE_STORAGE_DIR=

# Owned Content Factory runtime.
# On Vercel, /factory redirects to the media runtime so the UI and FFmpeg workers
# share the same job/state filesystem. Override only when moving the runtime.
CLIPFORGE_CONTENT_RUNTIME_URL=https://clipforge-runtime-free.onrender.com
# Rehydrate the three safe owned-content lines (3 platforms each). Publishing stays OFF.
CLIPFORGE_BOOTSTRAP_OWNED_CHANNELS=false
# Must remain false until explicitly enabling real publishing after OAuth/account setup.
CLIPFORGE_CONTENT_REAL_PUBLISHING=false

# Optional. URL/stream ingest worker polling interval in milliseconds.
CLIPFORGE_INGEST_POLL_MS=2500

# Optional. Maximum URL import process time. Defaults to 6 hours.
CLIPFORGE_URL_IMPORT_TIMEOUT_MS=

# Optional. Whisper CLI executable name/path.
# Install OpenAI Whisper in the worker environment; no API key is required
# for this local provider. Blank defaults to "whisper".
WHISPER_COMMAND=

# Optional. whisper.cpp executable/model when WHISPER_PROVIDER=cpp.
WHISPER_PROVIDER=
WHISPER_CPP_COMMAND=
WHISPER_CPP_MODEL_PATH=
WHISPER_CPP_THREADS=1

# Optional. Local Whisper model. Blank defaults to "base".
WHISPER_MODEL=

# Optional. ISO language code such as es/en/fr.
# Blank lets Whisper auto-detect the language.
WHISPER_LANGUAGE=

# Long-video transcription chunk size in seconds.
# Defaults to 600 (10 min), minimum 60, maximum 1800.
CLIPFORGE_TRANSCRIPTION_CHUNK_SECONDS=600

# Optional. Worker polling interval in milliseconds. Blank defaults to 2000.
CLIPFORGE_WORKER_POLL_MS=

# Optional. Autopilot orchestration polling interval in milliseconds.
# Blank defaults to 10000.
CLIPFORGE_AUTOPILOT_POLL_MS=

# Optional. Publishing worker polling interval in milliseconds.
# Blank defaults to 30000.
CLIPFORGE_PUBLISHING_POLL_MS=

# Optional. Analytics worker cycle interval. Minimum is 60000 ms.
# Blank defaults to 15 minutes.
CLIPFORGE_ANALYTICS_POLL_MS=

# Optional. Minimum age before refreshing analytics for the same publication.
# Blank defaults to 60 minutes.
CLIPFORGE_ANALYTICS_REFRESH_MS=

# Hosted owner access. Required on Vercel/hosted environments before the app opens.
# Keep both values server-side and out of the repository.
# Access key: at least 16 characters. Session key: at least 32 characters.
CLIPFORGE_OWNER_ACCESS_KEY=
CLIPFORGE_SESSION_KEY=
# Optional locally. Set true to require the owner login outside Vercel too.
CLIPFORGE_REQUIRE_OWNER_AUTH=false

# Required before storing OAuth credentials server-side.
# Generate 32 random bytes and store them as base64 outside the repository.
CLIPFORGE_CREDENTIALS_KEY=

# Required for OAuth state signing. Use a separate high-entropy secret.
CLIPFORGE_OAUTH_STATE_KEY=

# TikTok OAuth / Content Posting API app credentials.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REDIRECT_URI=
# Optional override. Space- or comma-separated scopes.
TIKTOK_OAUTH_SCOPES=video.publish

# Google / YouTube OAuth credentials.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
# Optional second Google OAuth client profile.
GOOGLE_CLIENT_ID_SECONDARY=
GOOGLE_CLIENT_SECRET_SECONDARY=
GOOGLE_REDIRECT_URI_SECONDARY=
# Optional override. Space-separated OAuth scopes.
GOOGLE_YOUTUBE_SCOPES=https://www.googleapis.com/auth/youtube.upload https://www.googleapis.com/auth/youtube.readonly

# Meta / Facebook OAuth credentials.
META_APP_ID=
META_APP_SECRET=
META_REDIRECT_URI=
# Set to the Graph API version approved/configured for the Meta app.
META_GRAPH_API_VERSION=
# Optional override. Space- or comma-separated scopes.
META_OAUTH_SCOPES=pages_show_list pages_read_engagement pages_manage_posts

# Content analysis provider. "heuristic" works without an external API.
# "openai" and "openai-compatible" both use the configurable transport below.
CLIPFORGE_ANALYSIS_PROVIDER=heuristic

# Auto Edit provider: "heuristic", "openai" or "openai-compatible".
CLIPFORGE_AUTOEDIT_PROVIDER=heuristic

# OpenAI-compatible provider settings. Keep the key server-side.
# Examples of base URLs: https://api.openai.com/v1 or a compatible provider's /v1 endpoint.
CLIPFORGE_AI_API_KEY=
CLIPFORGE_AI_BASE_URL=https://api.openai.com/v1
CLIPFORGE_AI_MODEL=
# auto = Responses API for api.openai.com, Chat Completions for other compatible hosts.
# Explicit values: responses | chat-completions
CLIPFORGE_AI_API_STYLE=auto
CLIPFORGE_AI_TEMPERATURE=0.2
CLIPFORGE_AI_MAX_OUTPUT_TOKENS=2048

# Backward-compatible aliases. Prefer CLIPFORGE_AI_* above.
OPENAI_API_KEY=
OPENAI_BASE_URL=

# Optional model used only by Auto Edit; blank falls back to CLIPFORGE_AI_MODEL.
CLIPFORGE_AUTOEDIT_MODEL=

# News Mode narration. Blank uses "espeak-ng" from PATH.
# Install espeak-ng on the worker or provide the executable path.
ESPEAK_NG_PATH=

# espeak-ng voice/language used by News Mode. Defaults to "es".
CLIPFORGE_NEWS_VOICE=es

# Narration speed for News Mode (roughly 120-220 words/minute). Defaults to 165.
CLIPFORGE_NEWS_TTS_SPEED=165
