FROM node:22-bookworm-slim AS whisper-builder

ARG WHISPER_CPP_COMMIT=d09f61a708f3487afa956ff578e60eae5e7a233c
ARG YTDLP_KICK_REF=04d2933856d7ddc5e088dab2d8328952c6986896

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    cmake \
    curl \
    git \
    python3 \
    python3-venv \
  && rm -rf /var/lib/apt/lists/*

RUN git clone --filter=blob:none https://github.com/ggml-org/whisper.cpp.git /src/whisper.cpp \
  && cd /src/whisper.cpp \
  && git checkout "${WHISPER_CPP_COMMIT}" \
  && cmake -S . -B build \
    -DCMAKE_BUILD_TYPE=Release \
    -DBUILD_SHARED_LIBS=OFF \
    -DGGML_NATIVE=OFF \
    -DWHISPER_BUILD_TESTS=OFF \
    -DWHISPER_BUILD_EXAMPLES=ON \
  && cmake --build build --config Release --target whisper-cli --parallel 2

RUN mkdir -p /opt/clipforge/models \
  && curl --fail --location --retry 3 \
    https://huggingface.co/ggerganov/whisper.cpp/resolve/main/ggml-tiny.bin \
    --output /opt/clipforge/models/ggml-tiny.bin \
  && test -s /opt/clipforge/models/ggml-tiny.bin \
  && python3 -m venv /opt/clipforge-ytdlp \
  && /opt/clipforge-ytdlp/bin/python -m pip install --no-cache-dir --upgrade pip setuptools wheel \
  && /opt/clipforge-ytdlp/bin/python -m pip install --no-cache-dir \
    "yt-dlp[default,curl-cffi] @ git+https://github.com/doe1080/yt-dlp.git@${YTDLP_KICK_REF}" \
  && /opt/clipforge-ytdlp/bin/yt-dlp --version >/dev/null \
  && /opt/clipforge-ytdlp/bin/yt-dlp --list-impersonate-targets | grep -q 'Chrome-'

FROM node:22-bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive
ENV NODE_ENV=production
ENV NEXT_TELEMETRY_DISABLED=1
ENV WHISPER_PROVIDER=cpp
ENV WHISPER_CPP_COMMAND=/usr/local/bin/whisper-cli
ENV WHISPER_CPP_MODEL_PATH=/opt/clipforge/models/ggml-tiny.bin
ENV WHISPER_CPP_THREADS=1
ENV ESPEAK_NG_PATH=/usr/bin/espeak-ng
ENV YTDLP_PATH=/opt/clipforge-ytdlp/bin/yt-dlp

RUN apt-get update \
  && apt-get install -y --no-install-recommends \
    ca-certificates \
    ffmpeg \
    espeak-ng \
    libgomp1 \
    python3 \
  && rm -rf /var/lib/apt/lists/*

COPY --from=whisper-builder /src/whisper.cpp/build/bin/whisper-cli /usr/local/bin/whisper-cli
COPY --from=whisper-builder /opt/clipforge/models/ggml-tiny.bin /opt/clipforge/models/ggml-tiny.bin
COPY --from=whisper-builder /opt/clipforge-ytdlp /opt/clipforge-ytdlp

WORKDIR /app

COPY package.json package-lock.json ./
RUN npm ci --include=dev

COPY . .
RUN npm run build \
  && npm prune --omit=dev

EXPOSE 10000

CMD ["node", "scripts/render-runtime-free.mjs"]
